# Copy values into the hosting dashboards; do not expose secrets with VITE_ prefixes.
# Shared by Vercel and backend:
APP_ORIGIN=https://your-site.vercel.app
PROXY_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Vercel only:
BACKEND_ORIGIN=https://your-backend.onrender.com
# Backend only:
NODE_ENV=production
HOST=0.0.0.0
DATA_DIR=/var/data/bookings
BACKUP_DIR=/var/data/backups
ADMIN_PASSWORD=choose-a-unique-password-of-at-least-15-characters
# Admin email recovery (backend only; configure all three to enable delivery):
ADMIN_EMAIL=you@example.com
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESET_EMAIL_FROM=Your Barbershop <admin@your-verified-domain.com>
